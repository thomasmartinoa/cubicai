<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only. The paired PC's self-signed cert is accepted by pin in LlmClient, not here. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
